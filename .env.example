# Copy this file to .env and fill in values for local testing

# Site
SITE_URL=http://localhost:8000

# Django
SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok.io

# Stripe (use test keys)
